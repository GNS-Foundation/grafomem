{
  "name": "@gns-foundation/cgr-verify",
  "version": "0.2.0",
  "description": "Offline, dependency-light verifier for GNS Foundation CGR attestations (cgr.attestation.v1/v2/v3/v4). Verify a Foundation-signed reputation attestation against a pinned issuer key — without trusting any server.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "test",
    "fixtures"
  ],
  "scripts": {
    "test": "node test/verify.test.mjs && node test/smoke.v4.test.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.8.0",
    "canonicalize": "^2.0.0"
  },
  "license": "MIT",
  "keywords": [
    "cgr",
    "attestation",
    "ed25519",
    "jcs",
    "rfc8785",
    "reputation",
    "verify"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GNS-Foundation/grafomem",
    "directory": "clients/cgr-verify"
  }
}
